# --- Fixture data: default-deny -------------------------------------------
# Your real subscription export (may contain PRIVATE member-feed tokens and
# personalized titles) must never be committed. Everything in fixtures/ is
# ignored EXCEPT the sanitized, public sample.
fixtures/*.json
fixtures/*.opml
!fixtures/sample-podcasts.json

# --- Xcode / Swift Package Manager ----------------------------------------
# The .xcodeproj is generated by XcodeGen, never hand-committed.
*.xcodeproj/
.build/
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/
Packages/*/.build/

# --- macOS ----------------------------------------------------------------
.DS_Store

#--- env file
.env

# --- Personal-dev signing (contains your Team ID; see project.personal.yml.template)
project.personal.yml

# xcodebuild derived data (local verification)
/build/

# --- arc-bakeoff / catalog: raw fetched corpus (regenerable via scripts/fetch-atlas-feeds.py)
curation/feeds/
# Episode descriptions are third-party copyrighted blurbs, fetched per show and
# regenerable via scripts/fetch-feed-descriptions.py.
curation/arc-bakeoff/descriptions/
# Theming intermediates: model input rebuilt by `build-episode-themes.py prepare`,
# and raw per-batch agent output merged by `finalize`. The committed artifacts are
# episode-themes/_vocabulary.json, <slug>.json and _run-report.json.
curation/arc-bakeoff/episode-themes/_input/
curation/arc-bakeoff/episode-themes/_input-all.json
curation/arc-bakeoff/episode-themes/_batch-plan.json
curation/arc-bakeoff/episode-themes/_work/
curation/catalog-build.log
curation/arc-bakeoff/fetch.log
**/__pycache__/
curation/catalog/_itunes_cache.json
curation/arc-bakeoff/gold_feeds/
curation/arc-bakeoff/scoreboard.json
curation/arc-bakeoff/diagnosis-*.json
curation/arc-bakeoff/memprec-*.json
curation/arc-bakeoff/verdicts-*.json
curation/arc-bakeoff/_adj_*.json
curation/arc-bakeoff/gold_manifest.json

# --- catalog browser: generated data (embeds the gitignored corpus) ---------
# human-verdicts.json is deliberately NOT ignored -- it is the human output and
# the whole point of the tool. Note curation/arc-bakeoff/verdicts-*.json above
# already matches a different, machine-generated file; don't rename into it.
curation/arc-bakeoff/catalog-index.json
curation/arc-bakeoff/gold-human.json
