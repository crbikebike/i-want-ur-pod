# --- Built catalog artifacts ----------------------------------------------
# The shipped .db is a build output, never a source. It is rebuilt from
# curation/source/ by catalog/build/ and published to R2 as a release.
catalog/releases/
*.db
*.db-journal
*.db-wal

# --- Raw fetched corpus: regenerable, and not ours ------------------------
# Feed XML, fetched per show. Regenerable via scripts/fetch-atlas-feeds.py.
curation/source/feeds/
curation/source/gold/feeds/
# Episode descriptions are third-party copyrighted blurbs, fetched per show and
# regenerable via scripts/fetch-feed-descriptions.py.
curation/source/descriptions/
# iTunes lookup cache.
curation/source/atlas/_itunes_cache.json
# Derived index over the corpus, rebuilt by the migration.
curation/source/catalog-index.json

# --- Theming-run intermediates --------------------------------------------
# Model input and raw per-batch output from the 2026-07 theming run. The kept
# artifacts are episode-themes/_vocabulary.json, <slug>.json and _run-report.json.
curation/source/episode-themes/_input/
curation/source/episode-themes/_input-all.json
curation/source/episode-themes/_batch-plan.json
curation/source/episode-themes/_assign-plan.json
curation/source/episode-themes/_work/

# --- Private feed data: default-deny --------------------------------------
# Real subscription exports may carry PRIVATE premium-feed tokens. Only the
# sanitized public sample is ever committed.
detector/fixtures/*
!detector/fixtures/sample-podcasts.json

# --- Local noise ----------------------------------------------------------
**/__pycache__/
*.log
.DS_Store
.env
node_modules/
dist/
.vite/
